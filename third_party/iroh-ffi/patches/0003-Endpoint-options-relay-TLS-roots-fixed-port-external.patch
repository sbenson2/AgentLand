+    /// Bind the endpoint's UDP sockets to a fixed port on all interfaces:
+    /// `0.0.0.0:port` (required) and `[::]:port` (used when IPv6 is available).
+    /// Binding fails if the IPv4 port is taken. Cannot be combined with
+    /// `bind_addr`; a refusal leaves the builder as it was.
+    pub fn bind_port(&self, port: u16) -> Result<(), IrohError> {
+        if port == 0 {
+            return Err(IrohError::invalid_input(
+                "bind_port must be 1-65535; leave it unset for a random port",
+            ));
+        }
+        self.add_bind_addrs(&[
+            (
+                SocketAddr::from((Ipv4Addr::UNSPECIFIED, port)),
+                BindOpts::default(),
+            ),
+            (
+                SocketAddr::from((Ipv6Addr::UNSPECIFIED, port)),
+                BindOpts::default().set_is_required(false),
+            ),
+        ])
+    }
+
+    /// Set the trust roots for TLS to relays. See [`RelayTlsRoots`].
+    pub fn relay_tls_roots(&self, roots: RelayTlsRoots) -> Result<(), IrohError> {
+        let config = roots.ca_tls_config()?;
+        self.map(|b| b.ca_tls_config(config))
+    }
+
+    /// Advertise an address (`host:port`) on which this endpoint is directly
+    /// reachable, such as a router mapping the application made itself.
+    pub fn external_addr(&self, addr: String) -> Result<(), IrohError> {
+        let socket = parse_socket_addr(&addr)?;
+        self.map(|b| b.external_addr(socket))
+    }
