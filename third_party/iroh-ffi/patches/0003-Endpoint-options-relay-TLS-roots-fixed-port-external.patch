+/// Trust roots for the endpoint's TLS connections to relays (and any other
+/// non-iroh TLS it makes, such as DNS-over-HTTPS). Connections between
+/// endpoints are authenticated by endpoint id and do not use these roots.
+///
+/// iroh applies one setting to every relay of the endpoint.
+#[derive(Debug, Clone, uniffi::Enum)]
+pub enum RelayTlsRoots {
+    /// The Mozilla roots compiled into iroh (iroh's default).
+    Embedded,
+    /// Only these DER-encoded certificates: a private CA, or a relay's own
+    /// self-signed certificate to pin it. Public roots are not trusted.
+    /// Hostname and validity are still checked.
+    Custom { certs: Vec<Vec<u8>> },
+    /// The Mozilla roots and these DER-encoded certificates, for a relay map
+    /// that mixes a relay with a private certificate and publicly trusted
+    /// relays (such as n0's). A public CA can then also vouch for the private
+    /// relay's name; `Custom` does not allow that.
+    EmbeddedPlus { certs: Vec<Vec<u8>> },
+}
+
+impl RelayTlsRoots {
+    fn ca_tls_config(&self) -> Result<CaTlsConfig, IrohError> {
+        match self {
+            RelayTlsRoots::Embedded => Ok(CaTlsConfig::embedded()),
+            RelayTlsRoots::Custom { certs } => {
+                Ok(CaTlsConfig::custom_roots(parse_roots("custom", certs)?))
+            }
+            RelayTlsRoots::EmbeddedPlus { certs } => Ok(CaTlsConfig::embedded()
+                .with_extra_roots(parse_roots("embeddedPlus", certs)?)),
+        }
+    }
+}
+
+/// The certificates as trust roots. iroh skips certificates it cannot parse;
+/// they are refused here so a bad pin fails the bind instead of silently
+/// trusting fewer roots.
+fn parse_roots(case: &str, certs: &[Vec<u8>]) -> Result<Vec<CertificateDer<'static>>, IrohError> {
+    if certs.is_empty() {
+        return Err(IrohError::invalid_input(format!(
+            "RelayTlsRoots.{case} needs at least one certificate"
+        )));
+    }
+    let certs: Vec<CertificateDer<'static>> = certs
+        .iter()
+        .map(|der| CertificateDer::from(der.clone()))
+        .collect();
+    let mut check = rustls::RootCertStore::empty();
+    for (index, cert) in certs.iter().enumerate() {
+        check.add(cert.clone()).map_err(|err| {
+            IrohError::invalid_input(format!(
+                "relay TLS certificate {index} is not a usable DER certificate: {err}"
+            ))
+        })?;
+    }
+    Ok(certs)
+}
+
