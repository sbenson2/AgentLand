+    #[tokio::test]
+    async fn test_agentland_options() {
+        let port = {
+            let probe = std::net::UdpSocket::bind("0.0.0.0:0").unwrap();
+            probe.local_addr().unwrap().port()
+        };
+        let ep = Endpoint::bind(EndpointOptions {
+            preset: Some(crate::preset_minimal()),
+            bind_port: Some(port),
+            relay_tls_roots: Some(RelayTlsRoots::Embedded),
+            external_addrs: Some(vec!["203.0.113.7:4242".to_string()]),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+        assert!(
+            ep.bound_sockets()
+                .iter()
+                .any(|a| a == &format!("0.0.0.0:{port}")),
+            "{:?}",
+            ep.bound_sockets()
+        );
+        assert!(
+            ep.addr()
+                .direct_addresses()
+                .contains(&"203.0.113.7:4242".to_string())
+        );
+        ep.add_external_addr("198.51.100.9:5000".to_string())
+            .await
+            .unwrap();
+        // The endpoint republishes its addresses asynchronously.
+        let deadline = tokio::time::Instant::now() + std::time::Duration::from_secs(5);
+        while !ep
+            .addr()
+            .direct_addresses()
+            .contains(&"198.51.100.9:5000".to_string())
+        {
+            assert!(
+                tokio::time::Instant::now() < deadline,
+                "{:?}",
+                ep.addr().direct_addresses()
+            );
+            tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+        }
+        ep.close().await.unwrap();
+    }
