+    // Which relay certificates each RelayTlsRoots accepts, checked with the
+    // verifier iroh builds from it. letsencrypt.org's chain (Let's Encrypt E8,
+    // ISRG Root X1; the copy in rustls-platform-verifier 0.7.0's tests, checked
+    // at a time it was valid) stands for a publicly trusted relay such as n0's;
+    // a certificate from a private CA for AgentLand's own relay.
+    #[test]
+    fn test_relay_tls_roots_trust() {
+        use rustls::pki_types::{ServerName, UnixTime, pem::PemObject};
+
+        fn pem(text: &[u8]) -> Vec<CertificateDer<'static>> {
+            CertificateDer::pem_slice_iter(text)
+                .collect::<Result<_, _>>()
+                .unwrap()
+        }
+        let public_chain = pem(include_bytes!(
+            "../testdata/relay-tls/letsencrypt-org-chain.pem"
+        ));
+        // 2026-04-08, inside the letsencrypt.org certificate's validity.
+        let public_time = UnixTime::since_unix_epoch(std::time::Duration::from_secs(1_775_649_786));
+        let private_ca = pem(include_bytes!("../testdata/relay-tls/private-ca.pem"))[0].to_vec();
+        let other_ca = pem(include_bytes!("../testdata/relay-tls/other-ca.pem"))[0].to_vec();
+        let private_chain = pem(include_bytes!("../testdata/relay-tls/private-relay.pem"));
+        // 2028-01-01; the private certificates are valid from 2026 to 2126.
+        let private_time = UnixTime::since_unix_epoch(std::time::Duration::from_secs(1_830_297_600));
+
+        let accepts = |roots: &RelayTlsRoots,
+                       chain: &[CertificateDer<'static>],
+                       name: &str,
+                       now: UnixTime|
+         -> bool {
+            let verifier = roots
+                .ca_tls_config()
+                .unwrap()
+                .server_cert_verifier(Arc::new(rustls::crypto::ring::default_provider()))
+                .unwrap();
+            let name = ServerName::try_from(name.to_string()).unwrap();
+            verifier
+                .verify_server_cert(&chain[0], &chain[1..], &name, &[], now)
+                .is_ok()
+        };
+        let public = |roots: &RelayTlsRoots| {
+            accepts(roots, &public_chain, "letsencrypt.org", public_time)
+        };
+        let private = |roots: &RelayTlsRoots| {
+            accepts(roots, &private_chain, "relay.agentland.test", private_time)
+        };
+
+        let embedded = RelayTlsRoots::Embedded;
+        let custom = RelayTlsRoots::Custom {
+            certs: vec![private_ca.clone()],
+        };
+        let both = RelayTlsRoots::EmbeddedPlus {
+            certs: vec![private_ca.clone()],
+        };
+        let other = RelayTlsRoots::EmbeddedPlus {
+            certs: vec![other_ca],
+        };
+
+        assert!(public(&embedded));
+        assert!(!private(&embedded));
+        assert!(!public(&custom));
+        assert!(private(&custom));
+        // Our relay and a public relay on the same endpoint.
+        assert!(public(&both));
+        assert!(private(&both));
+        // Only the given CA is added, and names are still checked.
+        assert!(!private(&other));
+        assert!(!accepts(
+            &both,
+            &private_chain,
+            "other.agentland.test",
+            private_time
+        ));
+    }
