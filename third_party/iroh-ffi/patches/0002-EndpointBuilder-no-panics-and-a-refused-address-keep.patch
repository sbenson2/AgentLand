+/// The wrapped builder, and the bind addresses it gets when it binds.
+///
+/// iroh's `Builder::bind_addr` takes the builder by value and drops it when it
+/// refuses the address, so bind addresses are checked on a scratch builder
+/// when they are set and applied to the real one only in
+/// [`EndpointBuilder::take_inner`].
+struct PendingBuilder {
+    builder: iroh::endpoint::Builder,
+    bind_addrs: Vec<(SocketAddr, BindOpts)>,
+}
+
+impl PendingBuilder {
+    fn add_bind_addrs(&mut self, addrs: &[(SocketAddr, BindOpts)]) -> Result<(), IrohError> {
+        // The real builder's own transports are iroh's defaults, which iroh does
+        // not count as user-defined, so an empty builder given the same list
+        // refuses exactly what the real one would.
+        let mut check = iroh::endpoint::Builder::empty();
+        for (addr, opts) in self.bind_addrs.iter().chain(addrs) {
+            check = check
+                .bind_addr_with_opts(*addr, opts.clone())
+                .map_err(|err| IrohError::invalid_input(format!("bind address {addr}: {err}")))?;
+        }
+        self.bind_addrs.extend_from_slice(addrs);
+        Ok(())
+    }
+
+    fn into_builder(self) -> Result<iroh::endpoint::Builder, IrohError> {
+        let mut builder = self.builder;
+        for (addr, opts) in self.bind_addrs {
+            builder = builder
+                .bind_addr_with_opts(addr, opts)
+                .map_err(|err| IrohError::invalid_input(format!("bind address {addr}: {err}")))?;
+        }
+        Ok(builder)
+    }
 }
 
