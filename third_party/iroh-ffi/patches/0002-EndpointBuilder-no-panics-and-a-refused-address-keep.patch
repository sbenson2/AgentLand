+    // A refused bind address used to drop the builder, and every later call
+    // then panicked ("EndpointBuilder consumed", then a poisoned mutex), which
+    // ends the process through the FFI. Calls after bind() panicked the same way.
+    #[tokio::test]
+    async fn test_builder_keeps_its_state_and_never_panics() {
+        let builder = EndpointBuilder::new();
+        builder.apply_minimal();
+        builder.bind_addr("127.0.0.1:0".to_string()).unwrap();
+        // A second IPv4 address is refused; the builder keeps the first.
+        let err = builder.bind_addr("127.0.0.1:1".to_string()).unwrap_err();
+        assert_eq!(err.kind(), crate::IrohErrorKind::InvalidInput, "{err}");
+        assert!(builder.bind_addr("not an address".to_string()).is_err());
+        builder.alpns(vec![b"after/refusal".to_vec()]);
+        builder.secret_key(vec![7; 32]).unwrap();
+        let ep = builder.bind().await.unwrap();
+        assert!(
+            ep.bound_sockets().iter().any(|a| a.starts_with("127.0.0.1:")),
+            "{:?}",
+            ep.bound_sockets()
+        );
+        assert_eq!(ep.secret_key().to_bytes(), vec![7; 32]);
+
+        // bind() used the builder: each call now fails or does nothing.
+        builder.apply_minimal();
+        builder.apply_n0();
+        builder.apply_n0_disable_relay();
+        builder.alpns(vec![]);
+        builder.relay_mode(&RelayMode::disabled());
+        assert!(builder.secret_key(vec![1; 32]).is_err());
+        assert!(builder.bind_addr("127.0.0.1:0".to_string()).is_err());
+        assert!(builder.bind().await.is_err());
+        ep.close().await.unwrap();
+    }
