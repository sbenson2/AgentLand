{
  "name": "Terminals",
  "about": "A shell used the way a person does: pwd, ls, mkdir and cd, echo, a long output loop interrupted by switching to a chat and back, Home and back, the background, the lock and a relaunch (the shell keeps running), Ctrl-C from the key bar, tab completion, history with the arrows, less and vim through the key bar, a second terminal, the OpenCode TUI, a host restart, Reconnect and End terminal.",
  "appearance": "light",
  "timeout": 1500,
  "launch": {"appearance": "light", "pair": true},
  "steps": [
    {"do": "helper", "name": "openWorkspace"},
    {"do": "helper", "name": "newTerminal", "argument": "shell"},
    {"do": "helper", "name": "captureCurrentTask", "as": "shellOne"},
    {"do": "screenshot", "name": "shell-new"},
    {"do": "terminalType", "text": "pwd\n"},
    {"do": "terminalSees", "text": "project", "timeout": 15, "soft": true},
    {"do": "terminalType", "text": "ls\n"},
    {"do": "terminalSees", "text": "ello.txt", "timeout": 15, "soft": true, "note": "OCR reads the h of hello.txt as n"},
    {"do": "terminalType", "text": "mkdir -p tester-dir && cd tester-dir && pwd && echo ${terminalMarker} > made-here.txt\n"},
    {"do": "terminalSees", "text": "tester-dir", "timeout": 15, "soft": true},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:tester-dir/made-here.txt", "contains": "${terminalMarker}", "timeout": 10}},
    {"do": "terminalType", "text": "cd ..\n"},
    {"do": "screenshot", "name": "shell-basics"},
    {"do": "note", "note": "Tab completion and history"},
    {"do": "terminalType", "text": "echo tabcomp > tabcompletion-target.txt\n"},
    {"do": "terminalType", "text": "cat tabcomp"},
    {"do": "tap", "id": "terminalKeyTab"},
    {"do": "terminalType", "text": "\n"},
    {"do": "terminalSees", "text": "tabcomp", "timeout": 10, "soft": true},
    {"do": "terminalType", "text": "echo history-one\n"},
    {"do": "tap", "id": "terminalKeyUp"},
    {"do": "terminalType", "text": " >> history.txt\n"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:history.txt", "contains": "history-one", "timeout": 10}},
    {"do": "screenshot", "name": "shell-tab-and-history"},
    {"do": "note", "note": "Ctrl-C from the key bar"},
    {"do": "terminalType", "text": "sleep 300\n"},
    {"do": "sleep", "seconds": 1},
    {"do": "tap", "id": "terminalKeyControl"},
    {"do": "terminalType", "text": "c"},
    {"do": "terminalType", "text": "echo after-ctrl-c > ctrl-c.txt\n"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:ctrl-c.txt", "contains": "after-ctrl-c", "timeout": 10}},
    {"do": "note", "note": "less and vim through the key bar"},
    {"do": "terminalType", "text": "seq 1 300 | less\n"},
    {"do": "terminalSees", "text": "12", "timeout": 10, "soft": true},
    {"do": "tap", "id": "terminalKeyDown"},
    {"do": "tap", "id": "terminalKeyDown"},
    {"do": "screenshot", "name": "less-arrows"},
    {"do": "terminalType", "text": "q"},
    {"do": "terminalType", "text": "vim -u NONE -N vim-proof.txt\n"},
    {"do": "sleep", "seconds": 1.5},
    {"do": "terminalType", "text": "iwritten in vim"},
    {"do": "screenshot", "name": "vim-insert"},
    {"do": "tap", "id": "terminalKeyEscape"},
    {"do": "terminalType", "text": ":wq\n"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:vim-proof.txt", "contains": "written in vim", "timeout": 10}},
    {"do": "terminalType", "text": "vim -u NONE -N vim-proof.txt\n"},
    {"do": "sleep", "seconds": 1},
    {"do": "terminalType", "text": "ddiignored"},
    {"do": "tap", "id": "terminalKeyEscape"},
    {"do": "terminalType", "text": ":q!\n"},
    {"do": "terminalType", "text": "echo vim-left > vim-left.txt\n"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:vim-left.txt", "contains": "vim-left", "timeout": 10}},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:vim-proof.txt", "contains": "written in vim", "lacks": "ignored"}},
    {"do": "tap", "id": "terminalHideKeyboard"},
    {"do": "keyboard", "shown": false},
    {"do": "note", "note": "A long loop, then a chat, Home, the background and a relaunch while it prints"},
    {"do": "terminalType", "text": "for i in $(seq 1 150); do echo loop$i; sleep 0.4; done; echo LOOPDONE > loop-done.txt\n"},
    {"do": "terminalSees", "text": "loop3", "timeout": 10, "soft": true},
    {"do": "helper", "name": "newPlainChat"},
    {"do": "screenshot", "name": "chat-while-loop"},
    {"do": "helper", "name": "chooseTaskID", "argument": "${shellOne}"},
    {"do": "wait", "id": "terminalCanvas", "timeout": 10},
    {"do": "terminalSees", "text": "loop", "timeout": 10, "soft": true},
    {"do": "screenshot", "name": "back-to-loop"},
    {"do": "helper", "name": "chooseTask", "argument": "Home"},
    {"do": "wait", "id": "homeNewChat"},
    {"do": "helper", "name": "chooseTaskID", "argument": "${shellOne}"},
    {"do": "wait", "id": "terminalCanvas", "timeout": 10},
    {"do": "background"},
    {"do": "sleep", "seconds": 3},
    {"do": "foreground"},
    {"do": "wait", "id": "terminalCanvas", "timeout": 15},
    {"do": "invariants"},
    {"do": "screenshot", "name": "loop-after-background"},
    {"do": "relaunch"},
    {"do": "wait", "id": "terminalCanvas", "timeout": 30},
    {"do": "invariants"},
    {"do": "screenshot", "name": "loop-after-relaunch"},
    {"do": "terminalSees", "text": "loop", "timeout": 15, "soft": true},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:loop-done.txt", "contains": "LOOPDONE", "timeout": 75}, "note": "the shell kept running through it all"},
    {"do": "terminalSees", "text": "loop150", "timeout": 15, "soft": true},
    {"do": "screenshot", "name": "loop-finished"},
    {"do": "note", "note": "The lock in the middle of output"},
    {"do": "launch", "appearance": "light", "lock": true},
    {"do": "wait", "id": "terminalCanvas", "timeout": 30},
    {"do": "terminalType", "text": "for i in $(seq 1 40); do echo lock$i; sleep 0.3; done; echo LOCKDONE > lock-done.txt\n"},
    {"do": "background"},
    {"do": "foreground"},
    {"do": "wait", "id": "terminalCanvas", "timeout": 15},
    {"do": "invariants"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:lock-done.txt", "contains": "LOCKDONE", "timeout": 30}},
    {"do": "terminalSees", "text": "lock40", "timeout": 10, "soft": true},
    {"do": "screenshot", "name": "after-lock"},
    {"do": "launch", "appearance": "light", "lock": false},
    {"do": "wait", "id": "terminalCanvas", "timeout": 30},
    {"do": "note", "note": "A second terminal; switching between the two"},
    {"do": "helper", "name": "newTerminal", "argument": "shell"},
    {"do": "terminalType", "text": "echo second-terminal > second.txt\n"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:second.txt", "contains": "second-terminal", "timeout": 10}},
    {"do": "helper", "name": "drawerPane", "argument": "workspaces", "note": "tasks switch only in the drawer (2026-10-05)"},
    {"do": "screenshot", "name": "drawer-two-terminals"},
    {"do": "assertCount", "type": "button", "idPrefix": "workspacePickerTab-", "atLeast": 1},
    {"do": "tap", "type": "button", "id": "${shellOne}"},
    {"do": "wait", "id": "terminalCanvas", "timeout": 10},
    {"do": "terminalSees", "text": "lock40", "soft": true, "timeout": 3, "note": "the first terminal kept the loop's output (LOCKDONE went to a file)"},
    {"do": "screenshot", "name": "first-terminal-again"},
    {"do": "note", "note": "The host restarts: the shell is gone; Reconnect and Close tab"},
    {"do": "host", "command": "stop"},
    {"do": "wait", "id": "connectionBanner", "timeout": 25},
    {"do": "terminalType", "text": "x"},
    {"do": "wait", "id": "terminalNotice", "timeout": 8, "soft": true, "note": "typing offline is refused visibly"},
    {"do": "screenshot", "name": "terminal-offline"},
    {"do": "host", "command": "start"},
    {"do": "waitGone", "id": "connectionBanner", "timeout": 45},
    {"do": "sleep", "seconds": 3},
    {"do": "screenshot", "name": "terminal-after-host-restart"},
    {"do": "invariants"},
    {"do": "helper", "name": "surfaceAction", "argument": "terminalReconnect", "label": "Reconnect", "soft": true},
    {"do": "sleep", "seconds": 3},
    {"do": "screenshot", "name": "terminal-after-reconnect"},
    {"do": "note", "note": "The task menu's Keys row: a tap on the row opens its keys"},
    {"do": "helper", "name": "surfaceMenu"},
    {"do": "tap", "id": "terminalKeys"},
    {"do": "sleep", "seconds": 1},
    {"do": "screenshot", "name": "task-menu-keys"},
    {"do": "assertExists", "type": "button", "id": "terminalInterrupt", "timeout": 3, "soft": true, "note": "a tap in the middle of the Keys row opens Escape, Tab, Control-C and the arrows"},
    {"do": "tapIfExists", "type": "button", "id": "terminalInterrupt", "timeout": 1},
    {"do": "assertAbsent", "id": "workspaceTaskPopover", "timeout": 3, "soft": true, "note": "a key chosen from Keys closes the whole task menu, as a native menu's submenu does"},
    {"do": "screenshot", "name": "task-menu-key-sent"},
    {"do": "helper", "name": "dismissTaskSwitcher"},
    {"do": "helper", "name": "dismissTaskSwitcher"},
    {"do": "note", "note": "OpenCode's TUI, then End terminal"},
    {"do": "helper", "name": "newTerminal", "argument": "opencode"},
    {"do": "sleep", "seconds": 6},
    {"do": "screenshot", "name": "opencode-tui"},
    {"do": "terminalSees", "text": "opencode", "timeout": 25, "soft": true},
    {"do": "helper", "name": "surfaceAction", "argument": "terminalEnd", "label": "End terminal"},
    {"do": "alert", "button": "End terminal"},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "opencode-ended"},
    {"do": "invariants"}
  ]
}
