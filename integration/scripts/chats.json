{
  "name": "Chats",
  "about": "A plain chat and an OpenCode chat with the fixture model: a reply, a draft that survives the app being killed, a streaming reply the tester leaves for a terminal and comes back to, Stop, a queued prompt, Edit and Resend, Use in Composer, a photo attachment, the agent chat's model and mode, Continue with another model, Copy Chat, Pin, Export and Delete.",
  "appearance": "light",
  "timeout": 1500,
  "prepare": ["photo"],
  "launch": {"appearance": "light", "pair": true},
  "steps": [
    {"do": "helper", "name": "newPlainChat"},
    {"do": "helper", "name": "captureCurrentTask", "as": "plain"},
    {"do": "wait", "id": "plainChatLanding", "timeout": 15},
    {"do": "screenshot", "name": "plain-landing"},
    {"do": "helper", "name": "chooseFixtureModel"},
    {"do": "type", "id": "chatDraft", "text": "Hello from the tester"},
    {"do": "tap", "id": "chatSend"},
    {"do": "wait", "type": "text", "label": "${chatReply}", "timeout": 45},
    {"do": "assertAbsent", "id": "plainChatLanding"},
    {"do": "screenshot", "name": "plain-reply"},

    {"do": "note", "note": "A draft survives killing the app"},
    {"do": "type", "id": "chatDraft", "text": "Draft that survives ${rand}"},
    {"do": "sleep", "seconds": 2},
    {"do": "relaunch"},
    {"do": "wait", "id": "chatDraft", "timeout": 30},
    {"do": "assertValue", "id": "chatDraft", "contains": "Draft that survives ${rand}", "timeout": 10},
    {"do": "screenshot", "name": "draft-after-relaunch"},
    {"do": "clear", "id": "chatDraft"},

    {"do": "note", "note": "A streaming reply, left for a terminal and back"},
    {"do": "type", "id": "chatDraft", "text": "AGENTLAND_STREAM please"},
    {"do": "tap", "id": "chatSend"},
    {"do": "wait", "id": "chatStop", "timeout": 20},
    {"do": "screenshot", "name": "streaming"},
    {"do": "helper", "name": "openWorkspace", "note": "a terminal needs a workspace; a plain chat has none"},
    {"do": "helper", "name": "newTerminal", "argument": "shell"},
    {"do": "terminalType", "text": "echo while-streaming > streaming.txt\n"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:streaming.txt", "contains": "while-streaming", "timeout": 10}},
    {"do": "helper", "name": "chooseTaskID", "argument": "${plain}"},
    {"do": "wait", "id": "chatDraft", "timeout": 10},
    {"do": "screenshot", "name": "back-to-stream"},
    {"do": "wait", "type": "any", "labelContains": "Streaming reply from the local fixture", "timeout": 60},
    {"do": "wait", "id": "chatSend", "timeout": 60},
    {"do": "assertExists", "type": "any", "labelContains": "one word at a time and ends with ${chatReply}", "timeout": 10, "note": "the whole streamed reply arrived while the tester was away"},
    {"do": "screenshot", "name": "stream-finished"},
    {"do": "invariants"},

    {"do": "note", "note": "Stop a long reply"},
    {"do": "type", "id": "chatDraft", "text": "AGENTLAND_LONG go on"},
    {"do": "tap", "id": "chatSend"},
    {"do": "wait", "id": "chatStop", "timeout": 20},
    {"do": "sleep", "seconds": 3},
    {"do": "tap", "id": "chatStop"},
    {"do": "wait", "id": "chatSend", "timeout": 20},
    {"do": "assertExists", "id": "chatStoppedMarker", "timeout": 10, "soft": true},
    {"do": "screenshot", "name": "stopped"},

    {"do": "note", "note": "Queue a prompt behind a slow reply"},
    {"do": "type", "id": "chatDraft", "text": "AGENTLAND_SLOW first"},
    {"do": "tap", "id": "chatSend"},
    {"do": "wait", "id": "chatStop", "timeout": 20},
    {"do": "type", "id": "chatDraft", "text": "Queued follow-up message"},
    {"do": "tap", "id": "chatQueueSend", "soft": true},
    {"do": "assertExists", "id": "chatQueue", "timeout": 5, "soft": true},
    {"do": "screenshot", "name": "queued"},
    {"do": "wait", "type": "text", "id": "chatUserMessage", "labelContains": "Queued follow-up message", "timeout": 60, "soft": true, "note": "B-15: the turn sent right after a Stop is sometimes stopped too, and nothing is queued"},
    {"do": "wait", "id": "chatSend", "timeout": 60},
    {"do": "screenshot", "name": "queue-sent"},
    {"do": "tapIfExists", "id": "chatSend", "timeout": 2, "note": "sends the follow-up if it was left in the composer"},
    {"do": "wait", "type": "text", "id": "chatUserMessage", "labelContains": "Queued follow-up message", "timeout": 30},
    {"do": "wait", "id": "chatSend", "timeout": 60},

    {"do": "note", "note": "Edit and Resend, Use in Composer"},
    {"do": "longPress", "type": "text", "id": "chatUserMessage", "last": true},
    {"do": "tap", "id": "chatEditLatest", "soft": true},
    {"do": "tapIfExists", "type": "button", "label": "Edit and Rewind", "timeout": 5},
    {"do": "assertValue", "id": "chatDraft", "contains": "Queued follow-up", "timeout": 5, "soft": true},
    {"do": "screenshot", "name": "edit-and-resend"},
    {"do": "clear", "id": "chatDraft"},
    {"do": "type", "id": "chatDraft", "text": "Edited prompt from the tester"},
    {"do": "tap", "id": "chatSend"},
    {"do": "wait", "type": "text", "id": "chatUserMessage", "labelContains": "Edited prompt from the tester", "timeout": 30},
    {"do": "wait", "id": "chatSend", "timeout": 60},
    {"do": "longPress", "type": "any", "id": "chatReply", "last": true},
    {"do": "screenshot", "name": "reply-menu"},
    {"do": "tap", "type": "button", "label": "Use in Composer"},
    {"do": "assertValue", "id": "chatDraft", "contains": "${chatReply}", "timeout": 5},
    {"do": "clear", "id": "chatDraft"},

    {"do": "note", "note": "Photos: the system picker opens (it runs out of process, so choosing a photo is not automated); swiping it away leaves the composer as it was"},
    {"do": "tap", "id": "chatOptions", "note": "the composer's + (Add Attachment)"},
    {"do": "tap", "id": "chatAttachPhotos"},
    {"do": "sleep", "seconds": 3},
    {"do": "screenshot", "name": "photo-picker"},
    {"do": "swipe", "direction": "down"},
    {"do": "sleep", "seconds": 2},
    {"do": "wait", "id": "chatDraft", "timeout": 10},
    {"do": "assertAbsent", "id": "chatPendingAttachments", "soft": true},
    {"do": "type", "id": "chatDraft", "text": "What is in this picture?"},
    {"do": "tap", "id": "chatSend"},
    {"do": "wait", "id": "chatSend", "timeout": 60},
    {"do": "screenshot", "name": "photo-sent"},

    {"do": "note", "note": "Copy Chat, Pin, Export from the chat's menu"},
    {"do": "helper", "name": "surfaceAction", "argument": "chatCopyChat", "label": "Copy Chat", "soft": true},
    {"do": "helper", "name": "surfaceAction", "argument": "chatPin", "label": "Pin", "soft": true},
    {"do": "sleep", "seconds": 1},
    {"do": "helper", "name": "surfaceAction", "argument": "chatSaveMarkdown", "label": "Save as Markdown", "soft": true},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "save-markdown"},
    {"do": "tapIfExists", "type": "button", "label": "Close", "timeout": 3},
    {"do": "tapIfExists", "type": "button", "label": "Cancel", "timeout": 2},
    {"do": "invariants"},

    {"do": "note", "note": "An OpenCode chat in the workspace"},
    {"do": "helper", "name": "openWorkspace"},
    {"do": "helper", "name": "newAgentChat", "argument": "opencode"},
    {"do": "screenshot", "name": "agent-landing", "note": "the plain chat's landing over the composer, no tiles (2026-10-07)"},
    {"do": "helper", "name": "chooseFixtureModel"},
    {"do": "tap", "id": "chatModeMenu", "soft": true},
    {"do": "screenshot", "name": "agent-mode-menu"},
    {"do": "tapIfExists", "type": "button", "label": "Plan", "timeout": 3},
    {"do": "type", "id": "chatDraft", "text": "Hello agent"},
    {"do": "tap", "id": "chatSend"},
    {"do": "wait", "type": "text", "label": "${chatReply}", "timeout": 60},
    {"do": "wait", "id": "chatSend", "timeout": 30},
    {"do": "screenshot", "name": "agent-reply"},
    {"do": "helper", "name": "surfaceAction", "argument": "chatContinue", "label": "Continue with Another Model…", "soft": true},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "continue-sheet"},
    {"do": "tapIfExists", "id": "chatContinueStart", "timeout": 5},
    {"do": "sleep", "seconds": 3},
    {"do": "screenshot", "name": "continued"},
    {"do": "invariants"},
    {"do": "helper", "name": "surfaceAction", "argument": "chatDelete", "label": "Delete…", "soft": true},
    {"do": "tapIfExists", "id": "confirmDeleteChat", "timeout": 5},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "after-delete"},
    {"do": "invariants"}
  ]
}
