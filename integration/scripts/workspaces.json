{
  "name": "Workspaces on the Mac",
  "about": "From Home's Workspace box the tester makes two new workspaces (one with Git, one without), opens an existing folder, browses up and down, switches between the workspaces in the drawer, opens a terminal in one, swipes its drawer row to Close and cancels (the shell keeps running), resumes it from Home, closes it from the Workspaces screen (its shell ends on the host), renames and removes it (the folder stays) and adds it back.",
  "appearance": "light",
  "timeout": 1200,
  "launch": {"appearance": "light", "pair": true},
  "steps": [
    {"do": "wait", "id": "homeNewChat", "timeout": 20},
    {"do": "tap", "id": "openWorkspace"},
    {"do": "wait", "id": "homeFolderCurrent", "timeout": 15},
    {"do": "assertLabel", "id": "homeFolderCurrent", "equals": "Developer"},
    {"do": "assertExists", "id": "homeFolder-sample-repo"},
    {"do": "assertExists", "id": "homeFolder-scratch"},
    {"do": "screenshot", "name": "workspace-box-developer"},
    {"do": "tap", "id": "homeFolder-sample-repo"},
    {"do": "assertLabel", "id": "homeFolderCurrent", "equals": "sample-repo", "timeout": 10},
    {"do": "screenshot", "name": "workspace-box-inside-repo"},
    {"do": "tap", "id": "homeFolderUp"},
    {"do": "assertLabel", "id": "homeFolderCurrent", "equals": "Developer", "timeout": 10},

    {"do": "tap", "id": "homeFolderNew", "note": "New Folder is New Workspace…"},
    {"do": "wait", "id": "newWorkspaceName", "timeout": 10},
    {"do": "keyboard", "shown": true, "timeout": 3, "soft": true, "note": "the sheet focuses its name field when it appears (B-10)"},
    {"do": "screenshot", "name": "new-workspace-sheet"},
    {"do": "assertValue", "id": "newWorkspaceGit", "equals": "1", "note": "Git is on by default"},
    {"do": "assertDisabled", "type": "button", "id": "newWorkspaceCreate", "note": "Create needs a name"},
    {"do": "tap", "id": "newWorkspaceCreate", "note": "a tester taps Create with no name"},
    {"do": "sleep", "seconds": 1},
    {"do": "screenshot", "name": "create-without-name"},
    {"do": "assertExists", "id": "newWorkspaceName", "note": "the sheet stays: nothing was made"},
    {"do": "type", "id": "newWorkspaceName", "text": "Tester One ${rand}"},
    {"do": "assertValue", "id": "newWorkspaceLocation", "contains": "Developer", "soft": true},
    {"do": "tap", "id": "newWorkspaceCreate"},
    {"do": "waitGone", "id": "newWorkspaceName", "timeout": 20},
    {"do": "assertValue", "id": "workspaceSwitcher", "contains": "Tester One", "timeout": 20},
    {"do": "screenshot", "name": "tester-one-opened"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "home:Developer/Tester One ${rand}", "dir": true}},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "home:Developer/Tester One ${rand}/.git", "dir": true}},
    {"do": "hostCheck", "command": "hostprojects", "payload": {"contains": "Tester One ${rand}"}},
    {"do": "invariants"},

    {"do": "helper", "name": "goHome"},
    {"do": "tap", "id": "openWorkspace"},
    {"do": "wait", "id": "homeFolderNew", "timeout": 15},
    {"do": "tap", "id": "homeFolderNew"},
    {"do": "wait", "id": "newWorkspaceName", "timeout": 10},
    {"do": "type", "id": "newWorkspaceName", "text": "Tester Two ${rand}"},
    {"do": "swipe", "direction": "up", "type": "any", "id": "newWorkspaceLocation", "note": "on a 375 pt phone the Git switch is under the keyboard; the form scrolls it up"},
    {"do": "tap", "type": "switch", "id": "newWorkspaceGit", "at": [0.92, 0.5]},
    {"do": "assertValue", "id": "newWorkspaceGit", "equals": "0"},
    {"do": "screenshot", "name": "new-workspace-no-git"},
    {"do": "tap", "id": "newWorkspaceCreate"},
    {"do": "waitGone", "id": "newWorkspaceName", "timeout": 20},
    {"do": "assertValue", "id": "workspaceSwitcher", "contains": "Tester Two", "timeout": 20},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "home:Developer/Tester Two ${rand}", "dir": true}},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "home:Developer/Tester Two ${rand}/.git", "absent": true}},

    {"do": "helper", "name": "goHome"},
    {"do": "tap", "id": "openWorkspace"},
    {"do": "wait", "id": "homeFolder-scratch", "timeout": 15},
    {"do": "tap", "id": "homeFolder-scratch"},
    {"do": "assertLabel", "id": "homeFolderCurrent", "equals": "scratch", "timeout": 10},
    {"do": "screenshot", "name": "workspace-box-scratch"},
    {"do": "tap", "id": "homeFolderOpen"},
    {"do": "assertValue", "id": "workspaceSwitcher", "contains": "scratch", "timeout": 20},
    {"do": "hostCheck", "command": "hostprojects", "payload": {"contains": "scratch"}},
    {"do": "screenshot", "name": "scratch-opened"},

    {"do": "helper", "name": "drawerPane", "argument": "workspaces"},
    {"do": "screenshot", "name": "drawer-four-workspaces"},
    {"do": "tap", "type": "button", "idPrefix": "drawerWorkspace-", "labelContains": "Tester One", "note": "a workspace's row shows its Home and closes the drawer (2026-10-06)"},
    {"do": "assertValue", "id": "workspaceSwitcher", "contains": "Tester One", "timeout": 10},
    {"do": "helper", "name": "drawerPane", "argument": "workspaces"},
    {"do": "tap", "type": "button", "idPrefix": "drawerWorkspace-", "labelContains": "Tester Two"},
    {"do": "assertValue", "id": "workspaceSwitcher", "contains": "Tester Two", "timeout": 10},
    {"do": "helper", "name": "drawerPane", "argument": "workspaces"},
    {"do": "tap", "type": "button", "id": "drawerWorkspace-fixture"},
    {"do": "assertValue", "id": "workspaceSwitcher", "contains": "Fixture", "timeout": 10},
    {"do": "helper", "name": "drawerPane", "argument": "workspaces"},
    {"do": "tap", "type": "button", "idPrefix": "drawerWorkspace-", "labelContains": "Tester One"},
    {"do": "assertValue", "id": "workspaceSwitcher", "contains": "Tester One", "timeout": 10},

    {"do": "helper", "name": "newTerminal", "argument": "shell"},
    {"do": "terminalType", "text": "pwd; echo $$ > shell.pid\n"},
    {"do": "terminalSees", "text": "Tester One", "timeout": 15},
    {"do": "hostCheck", "command": "hostpid", "payload": {"pidfile": "home:Developer/Tester One ${rand}/shell.pid", "alive": true, "timeout": 15}},
    {"do": "screenshot", "name": "terminal-in-tester-one"},

    {"do": "helper", "name": "drawerPane", "argument": "workspaces"},
    {"do": "swipe", "direction": "left", "type": "button", "idPrefix": "drawerWorkspace-", "labelContains": "Tester One"},
    {"do": "screenshot", "name": "drawer-swipe-revealed", "note": "a workspace's swipe is the Workspaces screen's: Remove and Close (2026-10-06)"},
    {"do": "tap", "type": "button", "id": "workspaceSwipeClose", "note": "by its identifier: the drawer also holds a hidden Close for Escape"},
    {"do": "wait", "id": "confirmCloseWorkspace", "timeout": 10},
    {"do": "screenshot", "name": "drawer-close-confirmation"},
    {"do": "tapAt", "at": [0.08, 0.97], "note": "from inside the drawer iOS 26 asks in a popover with no Cancel: a tap beside it cancels (Close is confirmed on the Workspaces screen below)"},
    {"do": "waitGone", "id": "confirmCloseWorkspace", "timeout": 5},
    {"do": "assertExists", "id": "workspaceExplorer", "note": "cancelling keeps the drawer open"},
    {"do": "hostCheck", "command": "hostpid", "payload": {"pidfile": "home:Developer/Tester One ${rand}/shell.pid", "alive": true}, "note": "a cancelled Close keeps the shell"},
    {"do": "helper", "name": "goHome"},
    {"do": "tap", "id": "homeRecentWork"},
    {"do": "wait", "type": "button", "idPrefix": "homeResumeWorkspace-", "labelContains": "Tester One", "timeout": 10, "scroll": "up", "note": "the box's choices are a lazy list: a workspace further down joins the tree as it scrolls"},
    {"do": "screenshot", "name": "resume-box-lists-workspaces"},
    {"do": "tap", "type": "button", "idPrefix": "homeResumeWorkspace-", "labelContains": "Tester One"},
    {"do": "assertValue", "id": "workspaceSwitcher", "contains": "Tester One", "timeout": 10},
    {"do": "helper", "name": "drawerPane", "argument": "workspaces"},
    {"do": "assertExists", "type": "button", "idPrefix": "workspacePickerTab-", "note": "the terminal came back with its workspace"},
    {"do": "screenshot", "name": "drawer-resumed"},
    {"do": "helper", "name": "closeDrawer"},

    {"do": "helper", "name": "homeChoice", "argument": "resume", "choice": "homeResumeWorkspaces", "note": "Home's Resume box ends with Workspaces… (2026-10-07)"},
    {"do": "wait", "id": "workspacesList", "timeout": 15},
    {"do": "screenshot", "name": "workspaces-screen"},
    {"do": "tap", "type": "button", "idPrefix": "workspaceMenu-pickerProject-", "labelContains": "Tester One"},
    {"do": "tap", "id": "workspaceActionClose"},
    {"do": "wait", "id": "confirmCloseWorkspace", "timeout": 10},
    {"do": "screenshot", "name": "close-workspace-confirmation"},
    {"do": "tap", "id": "confirmCloseWorkspace"},
    {"do": "hostCheck", "command": "hostpid", "payload": {"pidfile": "home:Developer/Tester One ${rand}/shell.pid", "alive": false, "timeout": 20}, "note": "Close ends this device's terminals there"},
    {"do": "screenshot", "name": "workspaces-after-close"},

    {"do": "tap", "type": "button", "idPrefix": "workspaceMenu-pickerProject-", "labelContains": "Tester One"},
    {"do": "tap", "id": "workspaceActionRename"},
    {"do": "wait", "type": "field", "valueContains": "Tester One", "timeout": 10, "note": "the alert's field (an alert drops SwiftUI identifiers); it has the focus"},
    {"do": "clear", "type": "field", "valueContains": "Tester One"},
    {"do": "type", "text": "Renamed One ${rand}"},
    {"do": "tap", "id": "workspaceRenameConfirm"},
    {"do": "wait", "type": "button", "idPrefix": "pickerProject-", "labelContains": "Renamed One", "timeout": 15},
    {"do": "hostCheck", "command": "hostprojects", "payload": {"contains": "Renamed One ${rand}"}},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "home:Developer/Tester One ${rand}", "dir": true}, "note": "a rename changes the name, not the folder"},
    {"do": "screenshot", "name": "workspace-renamed"},

    {"do": "tap", "type": "button", "idPrefix": "workspaceMenu-pickerProject-", "labelContains": "Renamed One"},
    {"do": "tap", "id": "workspaceActionRemove"},
    {"do": "wait", "id": "confirmRemoveWorkspace", "timeout": 10},
    {"do": "screenshot", "name": "remove-workspace-confirmation"},
    {"do": "tap", "id": "confirmRemoveWorkspace"},
    {"do": "waitGone", "type": "button", "idPrefix": "pickerProject-", "labelContains": "Renamed One", "timeout": 15},
    {"do": "hostCheck", "command": "hostprojects", "payload": {"absent": "Renamed One ${rand}"}},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "home:Developer/Tester One ${rand}/.git", "dir": true}, "note": "removing keeps the files"},
    {"do": "tap", "id": "workspacesDone"},
    {"do": "screenshot", "name": "after-remove"},
    {"do": "invariants"},

    {"do": "helper", "name": "goHome"},
    {"do": "tap", "id": "openWorkspace"},
    {"do": "wait", "type": "button", "id": "homeFolder-Tester One ${rand}", "timeout": 15},
    {"do": "assertValue", "type": "button", "id": "homeFolder-Tester One ${rand}", "lacks": "Already a workspace"},
    {"do": "tap", "type": "button", "id": "homeFolder-Tester One ${rand}"},
    {"do": "tap", "id": "homeFolderOpen"},
    {"do": "assertValue", "id": "workspaceSwitcher", "contains": "Tester One", "timeout": 20},
    {"do": "hostCheck", "command": "hostprojects", "payload": {"contains": "Tester One ${rand}"}},
    {"do": "screenshot", "name": "re-added"},
    {"do": "invariants"}
  ]
}
