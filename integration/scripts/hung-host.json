{
  "name": "A hung host at launch",
  "about": "B-14 regression. The host process is paused (it takes connections and never answers, as a wedged Mac or a dead relay would) while the app is relaunched, over a terminal and over Home. The opening cover lifts once the route race's 4 s probes find no answering address, within 6 s of launch, onto the offline banner and each surface's offline state; after the host resumes everything loads with the next connection epoch.",
  "appearance": "light",
  "timeout": 900,
  "launch": {"appearance": "light", "pair": true},
  "steps": [
    {"do": "helper", "name": "openWorkspace"},
    {"do": "helper", "name": "newTerminal", "argument": "shell"},
    {"do": "note", "note": "HUNG mark: pause, relaunch over the terminal"},
    {"do": "host", "command": "pause"},
    {"do": "relaunch"},
    {"do": "waitGone", "id": "hostLoadingScreen", "timeout": 6, "sinceLaunch": true},
    {"do": "screenshot", "name": "hung-terminal-after-cover"},
    {"do": "assertExists", "id": "connectionBanner", "timeout": 3},
    {"do": "assertExists", "id": "terminalRetryConnection", "timeout": 3},
    {"do": "host", "command": "resume"},
    {"do": "waitGone", "id": "terminalRetryConnection", "timeout": 30},
    {"do": "waitGone", "id": "connectionBanner", "timeout": 30},
    {"do": "wait", "id": "terminalCanvas", "timeout": 10},
    {"do": "screenshot", "name": "hung-terminal-recovered"},
    {"do": "helper", "name": "chooseTask", "argument": "Home"},
    {"do": "wait", "id": "homeNewChat", "timeout": 10},
    {"do": "note", "note": "HUNG mark: pause, relaunch over Home"},
    {"do": "host", "command": "pause"},
    {"do": "relaunch"},
    {"do": "waitGone", "id": "hostLoadingScreen", "timeout": 6, "sinceLaunch": true},
    {"do": "screenshot", "name": "hung-home-after-cover"},
    {"do": "assertExists", "id": "connectionBanner", "timeout": 3},
    {"do": "assertExists", "id": "homeHostOffline", "timeout": 3},
    {"do": "host", "command": "resume"},
    {"do": "waitGone", "id": "homeHostOffline", "timeout": 30},
    {"do": "waitGone", "id": "connectionBanner", "timeout": 30},
    {"do": "screenshot", "name": "hung-home-recovered"},
    {"do": "invariants"}
  ]
}
