{
  "name": "Every Settings control",
  "about": "Each Settings page from the header's Settings button (the 2026-10-04 structure: This Mac's Connection and Plain Chats, then Appearance, Chat, Terminal, Notifications, Privacy & Security and About), through the Settings helpers: Appearance's three choices and Reset, Notifications' permission prompt, Plain Chats' memory switch, Privacy & Security's device unlock (on, the lock on return, off), Connection's current host, About's version, device, what's new and notices; Settings over a terminal and a chat, and closed by the lock.",
  "appearance": "light",
  "timeout": 1200,
  "launch": {"appearance": "default", "pair": true},
  "steps": [
    {"do": "helper", "name": "openWorkspace"},
    {"do": "helper", "name": "openSettings"},
    {"do": "screenshot", "name": "settings-list"},
    {"do": "assertHittable", "id": "workspaceSwitcher", "note": "Settings opens below the header"},
    {"do": "invariants"},

    {"do": "helper", "name": "settingsPage", "argument": "Chat"},
    {"do": "screenshot", "name": "settings-chat"},
    {"do": "back"},
    {"do": "helper", "name": "settingsPage", "argument": "Terminal"},
    {"do": "screenshot", "name": "settings-terminal"},
    {"do": "back"},
    {"do": "helper", "name": "settingsPage", "argument": "Appearance"},
    {"do": "tap", "id": "appearanceOption-dark", "note": "Appearance is a checkmarked list of System, Light and Dark (batch 4)"},
    {"do": "assertSelected", "id": "appearanceOption-dark", "timeout": 5},
    {"do": "assertNotSelected", "id": "appearanceOption-system"},
    {"do": "screenshot", "name": "settings-appearance-dark"},
    {"do": "tap", "id": "appearanceOption-system"},
    {"do": "assertSelected", "id": "appearanceOption-system", "timeout": 5},
    {"do": "systemAppearance", "value": "dark"},
    {"do": "sleep", "seconds": 1},
    {"do": "screenshot", "name": "settings-appearance-system-dark"},
    {"do": "systemAppearance", "value": "light"},
    {"do": "tap", "id": "appearanceOption-light"},
    {"do": "assertSelected", "id": "appearanceOption-light", "timeout": 5},
    {"do": "tap", "id": "appearanceReset", "scroll": "up"},
    {"do": "assertSelected", "id": "appearanceOption-system", "timeout": 5, "note": "Reset Appearance returns to System (owner's decision, 2026-10-06)"},
    {"do": "assertNotSelected", "id": "appearanceOption-light"},
    {"do": "screenshot", "name": "settings-appearance-reset"},
    {"do": "tap", "id": "appearanceOption-light"},
    {"do": "assertSelected", "id": "appearanceOption-light", "timeout": 5},
    {"do": "back"},

    {"do": "helper", "name": "settingsPage", "argument": "Notifications"},
    {"do": "screenshot", "name": "settings-notifications"},
    {"do": "tapIfExists", "id": "notificationsPermission", "timeout": 3},
    {"do": "alert", "button": "Don’t Allow", "optional": true, "timeout": 5},
    {"do": "alert", "button": "Don't Allow", "optional": true, "timeout": 2},
    {"do": "sleep", "seconds": 1},
    {"do": "screenshot", "name": "settings-notifications-after-prompt"},
    {"do": "back"},

    {"do": "helper", "name": "settingsPage", "argument": "Plain Chats"},
    {"do": "screenshot", "name": "settings-plain-chats"},
    {"do": "tap", "type": "switch", "id": "memoryEnabled", "at": [0.92, 0.5], "soft": true},
    {"do": "sleep", "seconds": 1},
    {"do": "screenshot", "name": "settings-memory-off"},
    {"do": "tap", "type": "switch", "id": "memoryEnabled", "at": [0.92, 0.5], "soft": true},
    {"do": "assertExists", "type": "any", "id": "chatToolsList", "timeout": 5, "soft": true, "note": "the chat tools follow the memory on the same page"},
    {"do": "screenshot", "name": "settings-plain-chats-tools"},
    {"do": "back"},

    {"do": "helper", "name": "settingsPage", "argument": "Privacy & Security"},
    {"do": "tap", "type": "switch", "id": "privacyDeviceUnlock", "at": [0.92, 0.5]},
    {"do": "faceID"},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "after-turning-the-lock-on"},
    {"do": "assertValue", "type": "switch", "id": "privacyDeviceUnlock", "equals": "1", "timeout": 8, "note": "B-17: confirmed in place, Settings still open"},
    {"do": "screenshot", "name": "settings-lock-on"},
    {"do": "background"},
    {"do": "foreground"},
    {"do": "unlock", "timeout": 10},
    {"do": "screenshot", "name": "after-lock-with-settings"},
    {"do": "invariants"},
    {"do": "helper", "name": "settingsPage", "argument": "Privacy & Security"},
    {"do": "tap", "type": "switch", "id": "privacyDeviceUnlock", "at": [0.92, 0.5]},
    {"do": "assertValue", "type": "switch", "id": "privacyDeviceUnlock", "equals": "0", "timeout": 8, "note": "turning it off needs no confirmation"},
    {"do": "back"},

    {"do": "helper", "name": "settingsPage", "argument": "Connection"},
    {"do": "wait", "type": "text", "label": "Current host", "timeout": 8},
    {"do": "screenshot", "name": "settings-connection"},
    {"do": "back"},
    {"do": "helper", "name": "settingsPage", "argument": "About AgentLand"},
    {"do": "assertExists", "type": "any", "id": "aboutVersion", "timeout": 5},
    {"do": "screenshot", "name": "settings-about"},
    {"do": "assertExists", "type": "any", "id": "aboutWhatsNew", "scroll": "up", "timeout": 5, "soft": true},
    {"do": "screenshot", "name": "settings-about-whats-new"},
    {"do": "tap", "id": "aboutIrohNotices", "scroll": "up", "soft": true},
    {"do": "sleep", "seconds": 1},
    {"do": "screenshot", "name": "settings-iroh-notices"},
    {"do": "back", "note": "iroh's notices are a page of About"},
    {"do": "back"},
    {"do": "helper", "name": "closeSettings"},
    {"do": "invariants"},

    {"do": "note", "note": "Settings over a terminal, then over a chat"},
    {"do": "helper", "name": "newTerminal", "argument": "shell"},
    {"do": "terminalType", "text": "echo under-settings\n"},
    {"do": "helper", "name": "openSettings"},
    {"do": "screenshot", "name": "settings-over-terminal"},
    {"do": "assertAbsent", "type": "any", "id": "terminalKeyBar", "note": "no terminal keyboard over Settings", "soft": true},
    {"do": "helper", "name": "closeSettings"},
    {"do": "wait", "id": "terminalCanvas"},
    {"do": "terminalType", "text": "echo after-settings > after-settings.txt\n"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:after-settings.txt", "contains": "after-settings", "timeout": 10}},
    {"do": "helper", "name": "newPlainChat"},
    {"do": "type", "id": "chatDraft", "text": "draft under settings"},
    {"do": "helper", "name": "openSettings"},
    {"do": "screenshot", "name": "settings-over-chat"},
    {"do": "assertAbsent", "type": "any", "label": "Return", "note": "the chat keyboard goes with Settings open", "soft": true},
    {"do": "helper", "name": "closeSettings"},
    {"do": "assertValue", "id": "chatDraft", "contains": "draft under settings"},
    {"do": "invariants"}
  ]
}
