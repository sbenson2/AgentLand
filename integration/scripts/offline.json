{
  "name": "Offline refusal and recovery",
  "about": "With a chat, a terminal, an editor draft and the Git pane open, the host stops. Every surface keeps its content and refuses its input visibly: a chat send, terminal typing, a file save, a Git commit and a new workspace. The host comes back and each works again.",
  "appearance": "light",
  "timeout": 1200,
  "prepare": ["git"],
  "launch": {"appearance": "light", "pair": true},
  "steps": [
    {"do": "helper", "name": "openWorkspace"},
    {"do": "helper", "name": "newPlainChat"},
    {"do": "helper", "name": "captureCurrentTask", "as": "chat"},
    {"do": "helper", "name": "chooseFixtureModel"},
    {"do": "type", "id": "chatDraft", "text": "Before the host stops"},
    {"do": "tap", "id": "chatSend"},
    {"do": "wait", "type": "text", "label": "${chatReply}", "timeout": 45},
    {"do": "helper", "name": "newTerminal", "argument": "shell"},
    {"do": "helper", "name": "captureCurrentTask", "as": "term"},
    {"do": "terminalType", "text": "echo before-offline\n"},
    {"do": "terminalSees", "text": "before-offline"},
    {"do": "helper", "name": "openFile", "argument": "hello.txt"},
    {"do": "helper", "name": "captureCurrentTask", "as": "editor"},
    {"do": "type", "type": "textView", "id": "fileEditor", "text": "OFFLINE_DRAFT "},

    {"do": "host", "command": "stop"},
    {"do": "wait", "id": "connectionBanner", "timeout": 25},
    {"do": "screenshot", "name": "offline-editor"},
    {"do": "tap", "id": "saveFile", "soft": true},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "offline-save"},
    {"do": "assertExists", "id": "editorIssue", "timeout": 8, "soft": true, "note": "a save while offline says it was not saved"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:hello.txt", "lacks": "OFFLINE_DRAFT"}},
    {"do": "assertValue", "type": "textView", "id": "fileEditor", "contains": "OFFLINE_DRAFT"},

    {"do": "helper", "name": "chooseTaskID", "argument": "${term}"},
    {"do": "wait", "id": "terminalCanvas", "timeout": 10},
    {"do": "terminalSees", "text": "before-offline", "note": "the terminal keeps its output"},
    {"do": "terminalType", "text": "echo typed-offline\n"},
    {"do": "wait", "id": "terminalNotice", "timeout": 8},
    {"do": "screenshot", "name": "offline-terminal"},

    {"do": "helper", "name": "chooseTaskID", "argument": "${chat}"},
    {"do": "wait", "id": "chatDraft", "timeout": 10},
    {"do": "assertExists", "type": "text", "label": "${chatReply}", "note": "the chat keeps its transcript"},
    {"do": "type", "id": "chatDraft", "text": "Sent while offline"},
    {"do": "tapIfExists", "id": "chatSend", "timeout": 3},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "offline-chat"},
    {"do": "assertAbsent", "type": "text", "id": "chatUserMessage", "labelContains": "Sent while offline", "soft": true, "note": "nothing is queued for later"},

    {"do": "helper", "name": "drawerPane", "argument": "git"},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "offline-git"},
    {"do": "helper", "name": "closeDrawer"},
    {"do": "helper", "name": "goHome"},
    {"do": "tap", "id": "openWorkspace"},
    {"do": "sleep", "seconds": 3},
    {"do": "screenshot", "name": "offline-workspace-box"},
    {"do": "tapIfExists", "id": "homeActionBoxClose"},
    {"do": "invariants"},

    {"do": "host", "command": "start"},
    {"do": "waitGone", "id": "connectionBanner", "timeout": 45},
    {"do": "screenshot", "name": "back-online-home"},
    {"do": "helper", "name": "chooseTaskID", "argument": "${term}"},
    {"do": "wait", "id": "terminalCanvas", "timeout": 10},
    {"do": "sleep", "seconds": 3},
    {"do": "screenshot", "name": "terminal-after-host-restart"},
    {"do": "invariants"},
    {"do": "helper", "name": "chooseTaskID", "argument": "${editor}"},
    {"do": "wait", "type": "textView", "id": "fileEditor", "timeout": 10},
    {"do": "assertValue", "type": "textView", "id": "fileEditor", "contains": "OFFLINE_DRAFT", "note": "the draft outlived the host"},
    {"do": "tap", "id": "saveFile"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:hello.txt", "contains": "OFFLINE_DRAFT", "timeout": 15}},
    {"do": "helper", "name": "chooseTaskID", "argument": "${chat}"},
    {"do": "wait", "id": "chatDraft", "timeout": 10},
    {"do": "clear", "id": "chatDraft"},
    {"do": "type", "id": "chatDraft", "text": "After the host came back"},
    {"do": "tap", "id": "chatSend"},
    {"do": "wait", "type": "text", "id": "chatUserMessage", "labelContains": "After the host came back", "timeout": 20},
    {"do": "wait", "id": "chatSend", "timeout": 60},
    {"do": "screenshot", "name": "chat-after-recovery"},
    {"do": "helper", "name": "drawerPane", "argument": "git"},
    {"do": "wait", "type": "button", "id": "gitChange-changes-README.md", "timeout": 20},
    {"do": "swipe", "direction": "left", "type": "button", "id": "gitChange-changes-README.md", "note": "a file stages with its trailing swipe (GI-6)"},
    {"do": "tap", "id": "gitStage-README.md"},
    {"do": "type", "type": "any", "id": "gitCommitMessage", "text": "${commitMessage}"},
    {"do": "tap", "id": "gitCommit"},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["log", "-1", "--format=%s"], "equals": "${commitMessage}", "timeout": 20}},
    {"do": "screenshot", "name": "git-after-recovery"},
    {"do": "invariants"}
  ]
}
