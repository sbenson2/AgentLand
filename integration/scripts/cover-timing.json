{
  "name": "Covers with production motion",
  "about": "With animations on and the app lock on, as the owner uses it: how long the opening and lock covers stay after Face ID over an empty chat, a chat with messages, a terminal and Home; the curtain between tabs; nothing stuck past a few seconds.",
  "appearance": "light",
  "timeout": 900,
  "launch": {"appearance": "light", "animations": true, "pair": true},
  "steps": [
    {"do": "helper", "name": "newPlainChat"},
    {"do": "sleep", "seconds": 2},
    {"do": "launch", "appearance": "light", "animations": true, "lock": true},
    {"do": "waitGone", "id": "hostLoadingScreen", "timeout": 8},
    {"do": "screenshot", "name": "empty-chat-after-unlock"},
    {"do": "invariants"},
    {"do": "type", "id": "chatDraft", "text": "Hello with motion"},
    {"do": "tap", "id": "chatSend"},
    {"do": "wait", "type": "text", "label": "${chatReply}", "timeout": 45},
    {"do": "background"},
    {"do": "foreground"},
    {"do": "waitGone", "id": "hostLoadingScreen", "timeout": 8},
    {"do": "screenshot", "name": "chat-after-lock"},
    {"do": "invariants"},
    {"do": "launch", "appearance": "light", "animations": true, "lock": true},
    {"do": "waitGone", "id": "hostLoadingScreen", "timeout": 8},
    {"do": "assertExists", "type": "text", "label": "${chatReply}", "timeout": 5},
    {"do": "screenshot", "name": "chat-after-relaunch"},
    {"do": "helper", "name": "openWorkspace"},
    {"do": "helper", "name": "newTerminal", "argument": "shell"},
    {"do": "terminalType", "text": "echo motion\n"},
    {"do": "background"},
    {"do": "foreground"},
    {"do": "waitGone", "id": "hostLoadingScreen", "timeout": 8},
    {"do": "screenshot", "name": "terminal-after-lock"},
    {"do": "invariants"},
    {"do": "repeat", "times": 4, "steps": [
      {"do": "helper", "name": "chooseTask", "argument": "Home"},
      {"do": "wait", "id": "homeNewChat", "timeout": 8},
      {"do": "screenshot", "name": "curtain-home"},
      {"do": "helper", "name": "drawerPane", "argument": "workspaces", "note": "tasks switch only in the drawer (2026-10-05)"},
      {"do": "tap", "type": "button", "idPrefix": "workspacePickerTab-", "index": 0},
      {"do": "sleep", "seconds": 0.3},
      {"do": "screenshot", "name": "curtain-mid"},
      {"do": "sleep", "seconds": 2.5},
      {"do": "screenshot", "name": "curtain-after"},
      {"do": "invariants"}
    ]},
    {"do": "helper", "name": "openDrawer"},
    {"do": "sleep", "seconds": 0.12},
    {"do": "screenshot", "name": "drawer-growing"},
    {"do": "sleep", "seconds": 0.6},
    {"do": "screenshot", "name": "drawer-grown"},
    {"do": "helper", "name": "closeDrawer"},
    {"do": "helper", "name": "openSettings"},
    {"do": "screenshot", "name": "settings-grown"},
    {"do": "helper", "name": "closeSettings"},
    {"do": "invariants"}
  ]
}
