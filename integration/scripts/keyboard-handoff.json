{
  "name": "The terminal's keyboard when leaving the terminal",
  "about": "With the terminal's keyboard up, the tester leaves for Home and for a chat through the task switcher and the drawer, with and without production motion and after the lock. The terminal's keyboard and key bar must go with the terminal; nothing typed afterwards may reach the hidden shell.",
  "appearance": "light",
  "timeout": 1200,
  "launch": {"appearance": "light", "pair": true},
  "steps": [
    {"do": "helper", "name": "openWorkspace"},
    {"do": "helper", "name": "newPlainChat"},
    {"do": "helper", "name": "captureCurrentTask", "as": "chat"},
    {"do": "helper", "name": "newTerminal", "argument": "shell"},
    {"do": "helper", "name": "captureCurrentTask", "as": "term"},
    {"do": "terminalType", "text": "echo keyboard-up\n"},
    {"do": "keyboard", "shown": true},

    {"do": "note", "note": "1. Task switcher to Home, no motion"},
    {"do": "helper", "name": "chooseTask", "argument": "Home"},
    {"do": "wait", "id": "homeNewChat", "timeout": 8},
    {"do": "sleep", "seconds": 1},
    {"do": "screenshot", "name": "home-after-terminal-keyboard"},
    {"do": "keyboard", "shown": false, "timeout": 3, "soft": true},
    {"do": "assertAbsent", "type": "any", "id": "terminalKeyBar", "soft": true},
    {"do": "assertHittable", "id": "homeNewTerminal", "soft": true, "note": "Home's actions are not under a keyboard"},
    {"do": "type", "text": "echo LEAKHOME > leak-home.txt\n", "soft": true, "note": "typed with whatever keyboard is up"},
    {"do": "sleep", "seconds": 2},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:leak-home.txt", "absent": true}, "soft": true, "note": "nothing reaches the hidden shell"},

    {"do": "note", "note": "2. Task switcher to a chat, no motion"},
    {"do": "helper", "name": "chooseTaskID", "argument": "${term}"},
    {"do": "wait", "id": "terminalCanvas", "timeout": 10},
    {"do": "terminalType", "text": "echo keyboard-up-again\n"},
    {"do": "helper", "name": "chooseTaskID", "argument": "${chat}"},
    {"do": "wait", "id": "chatDraft", "timeout": 10},
    {"do": "sleep", "seconds": 1},
    {"do": "screenshot", "name": "chat-after-terminal-keyboard"},
    {"do": "assertAbsent", "type": "any", "id": "terminalKeyBar", "soft": true},

    {"do": "note", "note": "3. The drawer to a chat"},
    {"do": "helper", "name": "chooseTaskID", "argument": "${term}"},
    {"do": "wait", "id": "terminalCanvas", "timeout": 10},
    {"do": "terminalType", "text": "echo via-drawer\n"},
    {"do": "helper", "name": "drawerPane", "argument": "workspaces"},
    {"do": "screenshot", "name": "drawer-over-terminal-keyboard"},
    {"do": "keyboard", "shown": false, "timeout": 3, "soft": true, "note": "the drawer puts the keyboard away"},
    {"do": "helper", "name": "chooseTaskID", "argument": "${chat}", "note": "the plain chat is in the drawer's Chats group, opened as needed (2026-10-06)"},
    {"do": "wait", "id": "chatDraft", "timeout": 10},
    {"do": "sleep", "seconds": 1},
    {"do": "screenshot", "name": "chat-from-drawer"},
    {"do": "assertAbsent", "type": "any", "id": "terminalKeyBar", "soft": true},

    {"do": "note", "note": "4. With production motion and the lock"},
    {"do": "launch", "appearance": "light", "animations": true, "lock": true},
    {"do": "waitGone", "id": "appLockScreen", "timeout": 30},
    {"do": "waitGone", "id": "hostLoadingScreen", "timeout": 30},
    {"do": "invariants"},
    {"do": "helper", "name": "chooseTaskID", "argument": "${term}"},
    {"do": "wait", "id": "terminalCanvas", "timeout": 10},
    {"do": "terminalType", "text": "echo with-motion\n"},
    {"do": "background"},
    {"do": "foreground"},
    {"do": "wait", "id": "terminalCanvas", "timeout": 10},
    {"do": "helper", "name": "chooseTask", "argument": "Home"},
    {"do": "wait", "id": "homeNewChat", "timeout": 8},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "home-after-terminal-keyboard-motion"},
    {"do": "keyboard", "shown": false, "timeout": 3, "soft": true},
    {"do": "assertAbsent", "type": "any", "id": "terminalKeyBar", "soft": true},
    {"do": "type", "text": "echo LEAKMOTION > leak-motion.txt\n", "soft": true},
    {"do": "sleep", "seconds": 2},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:leak-motion.txt", "absent": true}, "soft": true},
    {"do": "invariants"},

    {"do": "note", "note": "5. With production motion, no lock: the keyboard up, the task switcher, Home"},
    {"do": "launch", "appearance": "light", "animations": true},
    {"do": "wait", "id": "homeNewChat", "timeout": 15},
    {"do": "helper", "name": "chooseTaskID", "argument": "${term}"},
    {"do": "wait", "id": "terminalCanvas", "timeout": 10},
    {"do": "terminalType", "text": "echo motion-no-lock\n"},
    {"do": "keyboard", "shown": true, "soft": true},
    {"do": "helper", "name": "chooseTask", "argument": "Home"},
    {"do": "wait", "id": "homeNewChat", "timeout": 8},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "home-after-terminal-keyboard-motion-no-lock"},
    {"do": "keyboard", "shown": false, "timeout": 3, "soft": true},
    {"do": "assertAbsent", "type": "any", "id": "terminalKeyBar", "soft": true},
    {"do": "invariants"},

    {"do": "note", "note": "6. The same with the chat's composer focused (motion on): its keyboard must go too"},
    {"do": "helper", "name": "chooseTaskID", "argument": "${chat}"},
    {"do": "wait", "id": "chatDraft", "timeout": 10},
    {"do": "type", "id": "chatDraft", "text": "draft over Home"},
    {"do": "keyboard", "shown": true, "soft": true},
    {"do": "helper", "name": "chooseTask", "argument": "Home"},
    {"do": "wait", "id": "homeNewChat", "timeout": 8},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "home-after-chat-keyboard-motion"},
    {"do": "keyboard", "shown": false, "timeout": 3, "soft": true, "note": "the switcher's popover must not hand the composer's keyboard back over Home"},
    {"do": "invariants"},

    {"do": "note", "note": "7. The editor focused (motion on): its keyboard must go too (the random walk's seed 2)"},
    {"do": "helper", "name": "openFile", "argument": "hello.txt"},
    {"do": "wait", "type": "textView", "id": "fileEditor", "timeout": 15},
    {"do": "tap", "type": "textView", "id": "fileEditor"},
    {"do": "keyboard", "shown": true, "soft": true},
    {"do": "helper", "name": "chooseTask", "argument": "Home"},
    {"do": "wait", "id": "homeNewChat", "timeout": 8},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "home-after-editor-keyboard-motion"},
    {"do": "keyboard", "shown": false, "timeout": 3, "soft": true, "note": "the switcher's popover must not hand the editor's keyboard back over Home"},
    {"do": "invariants"}
  ]
}
