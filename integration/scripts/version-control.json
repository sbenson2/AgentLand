{
  "name": "Git against a loopback remote",
  "about": "The drawer's Git pane on a repository whose origin is a loopback HTTP remote one commit ahead: stage and unstage, the diff, stash everything, pull (fast-forward), apply and drop the stash, discard a change, commit, push, branches made, switched and deleted, history, fetch.",
  "appearance": "light",
  "timeout": 1200,
  "prepare": ["git-remote"],
  "launch": {"appearance": "light", "pair": true},
  "steps": [
    {"do": "helper", "name": "openWorkspace"},
    {"do": "helper", "name": "drawerPane", "argument": "git"},
    {"do": "wait", "id": "gitTree", "timeout": 20},
    {"do": "wait", "type": "button", "id": "gitChange-changes-README.md", "timeout": 20},
    {"do": "assertExists", "type": "button", "id": "gitChange-changes-new-file.txt"},
    {"do": "screenshot", "name": "git-tree"},

    {"do": "swipe", "direction": "left", "type": "button", "id": "gitChange-changes-README.md", "note": "a file stages with its trailing swipe, as the iPad's Git tab does (GI-6)"},
    {"do": "tap", "id": "gitStage-README.md"},
    {"do": "wait", "type": "button", "id": "gitChange-staged-README.md", "timeout": 15},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["diff", "--cached", "--name-only"], "contains": "README.md", "timeout": 10}},
    {"do": "tap", "type": "button", "id": "gitChange-staged-README.md"},
    {"do": "wait", "id": "gitDiff", "timeout": 15},
    {"do": "screenshot", "name": "git-diff"},
    {"do": "tap", "type": "button", "id": "gitDiffDone"},
    {"do": "swipe", "direction": "left", "type": "button", "id": "gitChange-staged-README.md"},
    {"do": "tap", "id": "gitUnstage-README.md"},
    {"do": "wait", "type": "button", "id": "gitChange-changes-README.md", "timeout": 15},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["diff", "--cached", "--name-only"], "equals": "", "timeout": 10}},

    {"do": "note", "note": "Pull needs clean working files: stash everything first"},
    {"do": "tap", "type": "any", "id": "gitTreeSection-stashes", "scroll": "up", "soft": true},
    {"do": "tap", "type": "button", "id": "gitStashNew", "scroll": "up", "note": "Stash Changes… is a sheet holding a form (GI-3)"},
    {"do": "wait", "id": "gitStashMessage", "timeout": 5},
    {"do": "tap", "type": "switch", "label": "Include untracked files", "at": [0.92, 0.5], "note": "the switch itself, at the row's end"},
    {"do": "assertValue", "type": "switch", "label": "Include untracked files", "equals": "1"},
    {"do": "type", "id": "gitStashMessage", "text": "Tester stash"},
    {"do": "tap", "id": "gitStashSave", "note": "the sheet is the confirmation: Save saves at once"},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["stash", "list"], "contains": "Tester stash", "timeout": 15}},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["stash", "show", "--include-untracked", "--name-only", "stash@{0}"], "contains": "new-file.txt", "timeout": 5}, "note": "the stash holds the untracked file"},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["status", "--porcelain"], "equals": "", "timeout": 10}, "note": "B-6: and took it out of the working files"},
    {"do": "screenshot", "name": "git-stashed"},
    {"do": "waitGone", "type": "any", "id": "gitNotice", "timeout": 10, "soft": true, "note": "a saved stash shows only in the tree (GI-2, 2026-10-06: nothing for a plain success)"},

    {"do": "tap", "id": "gitTreeSection-remotes", "scroll": "down", "note": "Remotes opens (its sections start closed); it is above the stash form"},
    {"do": "tap", "type": "button", "id": "gitRemote-origin", "scroll": "up", "note": "Fetch, Pull and Push are in the remote's menu (GI-4)"},
    {"do": "tap", "type": "button", "label": "Fetch"},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["status", "-sb"], "contains": "behind 1", "timeout": 20}},
    {"do": "tap", "type": "button", "id": "gitRemote-origin", "scroll": "up"},
    {"do": "tap", "type": "button", "label": "Pull"},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["log", "--oneline", "-3"], "contains": "Remote commit to pull", "timeout": 20}},
    {"do": "screenshot", "name": "git-pulled"},

    {"do": "swipe", "direction": "left", "type": "button", "idPrefix": "gitStash-", "scroll": "up", "note": "a stash applies or drops with its swipe (GI-4)"},
    {"do": "tap", "type": "button", "idPrefix": "gitStashApply-"},
    {"do": "alert", "button": "Apply"},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["status", "--porcelain"], "contains": "README.md", "timeout": 15}},
    {"do": "swipe", "direction": "left", "type": "button", "idPrefix": "gitStash-", "scroll": "up"},
    {"do": "tap", "type": "button", "idPrefix": "gitStashDrop-"},
    {"do": "alert", "button": "Drop stash"},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["stash", "list"], "equals": "", "timeout": 15}},
    {"do": "screenshot", "name": "git-stash-applied-dropped"},

    {"do": "note", "note": "Discard the untracked file's neighbour: change notes.txt on the host, then discard it on the phone"},
    {"do": "hostCheck", "command": "hostwrite", "payload": {"path": "project:git-fixture/notes.txt", "append": "A change to discard.\n"}},
    {"do": "tap", "id": "gitTreeRefresh", "note": "Refresh is in the Git page's navigation bar, beside pull to refresh (GI-7)"},
    {"do": "wait", "type": "button", "id": "gitChange-changes-notes.txt", "timeout": 15, "scroll": "down", "note": "the changes are at the top of the list, above the stashes where the drop left it (run b9b2)"},
    {"do": "longPress", "type": "button", "id": "gitChange-changes-notes.txt"},
    {"do": "tap", "type": "button", "label": "Discard unstaged changes"},
    {"do": "alert", "button": "Discard"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:git-fixture/notes.txt", "lacks": "A change to discard", "timeout": 15}},

    {"do": "note", "note": "Commit README and push"},
    {"do": "swipe", "direction": "left", "type": "button", "id": "gitChange-changes-README.md", "scroll": "down"},
    {"do": "tap", "id": "gitStage-README.md"},
    {"do": "wait", "type": "button", "id": "gitChange-staged-README.md", "timeout": 15},
    {"do": "type", "type": "any", "id": "gitCommitMessage", "text": "${commitMessage}"},
    {"do": "tap", "id": "gitCommit"},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["log", "-1", "--format=%s"], "equals": "${commitMessage}", "timeout": 20}},
    {"do": "screenshot", "name": "git-committed"},
    {"do": "tap", "type": "button", "id": "gitRemote-origin", "scroll": "up"},
    {"do": "tap", "type": "button", "label": "Push"},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["status", "-sb"], "lacks": "ahead", "timeout": 25}},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["log", "--oneline", "-1", "origin/main"], "contains": "${commitMessage}", "timeout": 10}},
    {"do": "screenshot", "name": "git-pushed"},

    {"do": "note", "note": "Branches"},
    {"do": "tap", "type": "any", "id": "gitTreeSection-branches", "scroll": "down", "note": "Branches is above History and Remotes, where the push left the tree"},
    {"do": "tap", "type": "button", "id": "gitNewBranch", "scroll": "up", "note": "New Branch… asks for the name in an alert (GI-3)"},
    {"do": "type", "text": "tester-branch", "note": "the alert's field has the keyboard"},
    {"do": "tap", "type": "button", "id": "gitCreateBranch"},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["branch", "--list", "tester-branch"], "contains": "tester-branch", "timeout": 10}, "note": "Create branch makes it; it does not switch to it"},
    {"do": "wait", "type": "button", "id": "gitBranch-tester-branch", "timeout": 15, "note": "no scroll: the row comes in beside New Branch once the host has it, and a drag before it arrives took the lazy list past Branches (run b9b3)"},
    {"do": "screenshot", "name": "git-branch-made"},
    {"do": "tap", "type": "button", "id": "gitNewBranch"},
    {"do": "assertValue", "type": "field", "last": true, "lacks": "tester-branch", "soft": true, "note": "B-19: the name is cleared once the branch is made; the system alert drops its field's identifier, and the alert's is the last field (run b9b4)"},
    {"do": "alert", "button": "Cancel"},
    {"do": "tap", "type": "button", "id": "gitBranch-tester-branch", "note": "the stash's untracked file is still there, so the host refuses the switch"},
    {"do": "wait", "type": "text", "labelContains": "before switching branches", "timeout": 10, "note": "the refusal is the system's alert (GI-2, 2026-10-06)"},
    {"do": "assertVisible", "type": "text", "labelContains": "before switching branches", "soft": true, "note": "B-20: the refusal shows in sight wherever the branch row was"},
    {"do": "alert", "button": "OK"},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["branch", "--show-current"], "equals": "main", "timeout": 10}},
    {"do": "swipe", "direction": "left", "type": "button", "id": "gitBranch-tester-branch", "note": "a branch deletes with its swipe (GI-5)"},
    {"do": "tap", "type": "button", "id": "gitBranchDelete-tester-branch"},
    {"do": "alert", "button": "Delete branch"},
    {"do": "hostCheck", "command": "hostgit", "payload": {"repo": "project:git-fixture", "args": ["branch"], "lacks": "tester-branch", "timeout": 10}},

    {"do": "note", "note": "History, open from the start (2026-10-06); a commit pushes its page in the drawer (GI-8)"},
    {"do": "assertExists", "type": "any", "idPrefix": "gitHistory-", "timeout": 10, "soft": true},
    {"do": "tap", "type": "any", "idPrefix": "gitHistory-", "soft": true},
    {"do": "wait", "id": "gitSavedChange", "timeout": 10, "soft": true},
    {"do": "tap", "type": "button", "idPrefix": "gitSavedFile-", "timeout": 15, "soft": true},
    {"do": "wait", "id": "gitDiff", "timeout": 15, "soft": true},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "git-history"},
    {"do": "tapIfExists", "type": "button", "id": "gitDiffDone", "timeout": 3},
    {"do": "back", "soft": true},
    {"do": "invariants"}
  ]
}
