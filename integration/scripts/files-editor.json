{
  "name": "Files and the editor",
  "about": "The drawer's Files page: a folder opens in place and its breadcrumb goes back, a file opens in the editor; an edit is saved (the host has the bytes); a dirty close asks, Keep Editing keeps the draft, Discard drops it; a draft survives a relaunch; the host changes the file under a draft and Save keeps the edits with a conflict notice whose confirmed choices replace either side (B-2); the untouched agent chat's Browse files button.",
  "appearance": "light",
  "timeout": 1200,
  "launch": {"appearance": "light", "pair": true},
  "steps": [
    {"do": "helper", "name": "openWorkspace"},
    {"do": "helper", "name": "drawerPane", "argument": "files"},
    {"do": "wait", "id": "drawerFile-hello.txt", "timeout": 15},
    {"do": "assertExists", "id": "drawerFile-Sources"},
    {"do": "screenshot", "name": "files-pane"},
    {"do": "tap", "id": "drawerFile-Sources"},
    {"do": "wait", "id": "drawerFile-Sources/example.swift", "timeout": 10},
    {"do": "screenshot", "name": "files-folder-open"},
    {"do": "tap", "type": "any", "label": "Sources", "within": "workspaceExplorer", "note": "the page is titled with the folder; its title menu lists the folders above it (FI-1)"},
    {"do": "tap", "type": "button", "label": "Fixture", "note": "a folder opens in place; the title menu's workspace folder goes back (the system's title menu drops its items' identifiers, so fileBreadcrumbRoot is found by the workspace's name)"},
    {"do": "waitGone", "id": "drawerFile-Sources/example.swift", "timeout": 10},
    {"do": "wait", "id": "drawerFile-hello.txt", "timeout": 10},
    {"do": "assertValue", "id": "workspaceSwitcher", "contains": "Home", "note": "browsing files keeps Home underneath"},
    {"do": "tap", "id": "drawerFile-hello.txt"},
    {"do": "wait", "type": "any", "id": "fileInspector", "timeout": 15, "note": "a file's tap shows it read-only first (2026-10-06)"},
    {"do": "screenshot", "name": "file-inspector"},
    {"do": "tap", "type": "button", "id": "fileInspectorOpen"},
    {"do": "wait", "type": "textView", "id": "fileEditor", "timeout": 15},
    {"do": "assertValue", "type": "textView", "id": "fileEditor", "contains": "Hello from AgentLand."},
    {"do": "assertValue", "id": "workspaceSwitcher", "contains": "hello.txt"},
    {"do": "helper", "name": "captureCurrentTask", "as": "editor"},
    {"do": "screenshot", "name": "editor-open"},

    {"do": "type", "type": "textView", "id": "fileEditor", "text": "SAVED_BY_TESTER_${rand} "},
    {"do": "assertEnabled", "id": "saveFile"},
    {"do": "tap", "id": "saveFile"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:hello.txt", "contains": "SAVED_BY_TESTER_${rand}", "timeout": 15}},
    {"do": "assertDisabled", "id": "saveFile", "timeout": 10},
    {"do": "screenshot", "name": "editor-saved"},

    {"do": "type", "type": "textView", "id": "fileEditor", "text": "KEEP_${rand} "},
    {"do": "helper", "name": "closeTask", "argument": "hello.txt"},
    {"do": "wait", "id": "keepEditing", "timeout": 8},
    {"do": "screenshot", "name": "dirty-close-asks"},
    {"do": "tap", "id": "keepEditing"},
    {"do": "assertExists", "type": "button", "id": "${editor}", "timeout": 5},
    {"do": "tap", "type": "button", "id": "${editor}"},
    {"do": "assertValue", "type": "textView", "id": "fileEditor", "contains": "KEEP_${rand}", "timeout": 10},

    {"do": "note", "note": "The draft survives a relaunch"},
    {"do": "relaunch"},
    {"do": "wait", "type": "textView", "id": "fileEditor", "timeout": 30},
    {"do": "assertValue", "type": "textView", "id": "fileEditor", "contains": "KEEP_${rand}", "timeout": 10},
    {"do": "screenshot", "name": "draft-after-relaunch"},
    {"do": "invariants"},

    {"do": "helper", "name": "closeTask", "argument": "hello.txt"},
    {"do": "wait", "id": "discardChanges", "timeout": 8},
    {"do": "tap", "id": "discardChanges"},
    {"do": "assertAbsent", "type": "button", "id": "${editor}", "timeout": 5},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:hello.txt", "lacks": "KEEP_${rand}"}},
    {"do": "helper", "name": "closeDrawer"},
    {"do": "invariants"},

    {"do": "note", "note": "The host changes the file under a draft"},
    {"do": "helper", "name": "openFile", "argument": "hello.txt"},
    {"do": "assertValue", "type": "textView", "id": "fileEditor", "contains": "SAVED_BY_TESTER_${rand}", "lacks": "KEEP_${rand}", "timeout": 10},
    {"do": "type", "type": "textView", "id": "fileEditor", "text": "LOCAL_${rand} "},
    {"do": "hostCheck", "command": "hostwrite", "payload": {"path": "project:hello.txt", "append": "HOST_CHANGE_${rand}\n"}},
    {"do": "tap", "id": "saveFile"},
    {"do": "wait", "type": "any", "id": "editorConflict", "timeout": 15},
    {"do": "screenshot", "name": "editor-conflict"},
    {"do": "assertValue", "type": "textView", "id": "fileEditor", "contains": "LOCAL_${rand}", "note": "the edits are kept"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:hello.txt", "contains": "HOST_CHANGE_${rand}", "lacks": "LOCAL_${rand}"}},
    {"do": "assertExists", "id": "editorCopyDraft", "note": "Copy keeps the draft at hand"},
    {"do": "tap", "id": "editorSaveMine"},
    {"do": "sleep", "seconds": 1},
    {"do": "screenshot", "name": "save-mine-confirmation"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:hello.txt", "lacks": "LOCAL_${rand}"}, "note": "nothing is replaced before the confirmation"},
    {"do": "tap", "id": "editorConfirmSaveMine"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:hello.txt", "contains": "LOCAL_${rand}", "lacks": "HOST_CHANGE_${rand}", "timeout": 15}, "note": "B-2: the draft replaced the Mac's file"},
    {"do": "waitGone", "type": "any", "id": "editorConflict", "timeout": 10},
    {"do": "assertDisabled", "id": "saveFile", "timeout": 10},

    {"do": "type", "type": "textView", "id": "fileEditor", "text": "SECOND_${rand} "},
    {"do": "hostCheck", "command": "hostwrite", "payload": {"path": "project:hello.txt", "append": "HOST_AGAIN_${rand}\n"}},
    {"do": "tap", "id": "saveFile"},
    {"do": "wait", "type": "any", "id": "editorConflict", "timeout": 15},
    {"do": "tap", "id": "editorUseHost"},
    {"do": "sleep", "seconds": 1},
    {"do": "screenshot", "name": "use-host-confirmation"},
    {"do": "tap", "id": "editorConfirmUseHost"},
    {"do": "assertValue", "type": "textView", "id": "fileEditor", "contains": "HOST_AGAIN_${rand}", "lacks": "SECOND_${rand}", "timeout": 15, "note": "B-2: the Mac's version replaced the draft"},
    {"do": "hostCheck", "command": "hostfile", "payload": {"path": "project:hello.txt", "contains": "HOST_AGAIN_${rand}", "lacks": "SECOND_${rand}"}},
    {"do": "waitGone", "type": "any", "id": "editorConflict", "timeout": 10},
    {"do": "screenshot", "name": "editor-after-use-host"},
    {"do": "invariants"}
  ]
}
