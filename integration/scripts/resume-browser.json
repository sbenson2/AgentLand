{
  "name": "Resume Work and Browser",
  "about": "Run with --enable-preview (the script asks for it). Resume Work, a sheet on iPhone reached from an untouched agent chat's landing: the chat library after a plain chat, its search, the host's terminals and terminal logs; New Browser Tab opens the preview fixture's page through the host's preview listener; the Browser's reload, back and forward; Home's Resume box.",
  "appearance": "light",
  "timeout": 1200,
  "preview": true,
  "launch": {"appearance": "light", "pair": true},
  "steps": [
    {"do": "helper", "name": "newPlainChat"},
    {"do": "helper", "name": "chooseFixtureModel"},
    {"do": "type", "id": "chatDraft", "text": "Something to resume later"},
    {"do": "tap", "id": "chatSend"},
    {"do": "wait", "type": "text", "label": "${chatReply}", "timeout": 45},
    {"do": "helper", "name": "openWorkspace"},
    {"do": "helper", "name": "newTerminal", "argument": "shell"},
    {"do": "terminalType", "text": "echo resume-me\n"},
    {"do": "helper", "name": "newAgentChat", "argument": "opencode"},
    {"do": "screenshot", "name": "agent-landing", "note": "the plain chat's landing over the composer, no tiles (2026-10-07)"},
    {"do": "helper", "name": "drawerPane", "argument": "resume", "note": "Home's Resume box, Search History (2026-10-07)"},
    {"do": "wait", "type": "search", "timeout": 10},
    {"do": "tap", "type": "search"},
    {"do": "screenshot", "name": "resume-work-search-focused"},
    {"do": "type", "text": "resume", "note": "typed into the focused search"},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "resume-search"},
    {"do": "assertVisible", "type": "search", "soft": true, "note": "B-11: the search field a person types into is in sight, above the keyboard"},
    {"do": "assertExists", "type": "any", "labelContains": "Something to resume", "timeout": 10, "soft": true},
    {"do": "helper", "name": "endResumeSearch"},
    {"do": "screenshot", "name": "resume-work"},
    {"do": "assertExists", "type": "any", "id": "sidebarChat", "timeout": 30, "soft": true},
    {"do": "assertExists", "type": "any", "id": "sidebarTerminal", "timeout": 10, "soft": true, "scroll": "up"},
    {"do": "assertExists", "type": "any", "id": "sidebarNewBrowserTab", "timeout": 10, "soft": true, "scroll": "up"},
    {"do": "tap", "type": "any", "id": "sidebarNewBrowserTab", "scroll": "up", "note": "the sheet's search field is in its bar, over none of the rows"},
    {"do": "wait", "type": "any", "id": "browserPorts", "timeout": 20, "soft": true, "note": "B-18: New Browser Tab in Resume Work shows nothing on iPhone; the Browser steps are soft until it does"},
    {"do": "screenshot", "name": "browser-ports"},
    {"do": "tap", "type": "any", "id": "browserPort-${previewPort}", "scroll": "up", "scrolls": 20, "soft": true, "timeout": 5, "note": "the fixture's port is ephemeral, so its row sorts low among the Mac's dozens of listening ports"},
    {"do": "screenSees", "text": "AgentLand preview fixture", "timeout": 10, "soft": true},
    {"do": "screenshot", "name": "browser-page"},
    {"do": "tap", "type": "any", "label": "Second page", "soft": true, "timeout": 5},
    {"do": "screenSees", "text": "Second preview page", "timeout": 5, "soft": true},
    {"do": "tap", "id": "browserMore", "soft": true, "timeout": 5, "note": "on iPhone Back and Forward are in the More menu; the bar's own buttons are iPad's"},
    {"do": "tap", "type": "button", "label": "Back", "soft": true, "timeout": 5},
    {"do": "screenSees", "text": "AgentLand preview fixture", "timeout": 5, "soft": true},
    {"do": "tap", "id": "browserMore", "soft": true, "timeout": 5},
    {"do": "tap", "type": "button", "label": "Forward", "soft": true, "timeout": 5},
    {"do": "tap", "id": "browserReload", "soft": true, "timeout": 5},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "browser-after-navigation"},
    {"do": "helper", "name": "closeDrawer", "note": "closes Resume Work if the Browser never opened"},
    {"do": "invariants"},
    {"do": "relaunch"},
    {"do": "sleep", "seconds": 3},
    {"do": "screenshot", "name": "browser-after-relaunch"},
    {"do": "invariants"},
    {"do": "helper", "name": "goHome"},
    {"do": "tap", "id": "homeRecentWork"},
    {"do": "wait", "type": "button", "id": "homeResumeWorkspace-fixture", "timeout": 10},
    {"do": "screenshot", "name": "home-resume-box"},
    {"do": "tap", "type": "button", "id": "homeResumeWorkspace-fixture"},
    {"do": "sleep", "seconds": 1},
    {"do": "screenshot", "name": "resumed-fixture"},
    {"do": "invariants"},
    {"do": "note", "note": "Terminal Logs from Resume Work (B-18), last because it may leave Resume Work up"},
    {"do": "helper", "name": "drawerPane", "argument": "resume"},
    {"do": "sleep", "seconds": 1},
    {"do": "helper", "name": "endResumeSearch", "soft": true},
    {"do": "screenshot", "name": "resume-work-again"},
    {"do": "tap", "type": "any", "id": "sidebarTerminalLogs", "scroll": "up", "soft": true},
    {"do": "wait", "type": "any", "id": "archiveList", "timeout": 10, "soft": true, "note": "B-18: Terminal Logs opens the archive's terminal logs"},
    {"do": "screenshot", "name": "terminal-logs"}
  ]
}
