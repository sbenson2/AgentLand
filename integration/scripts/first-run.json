{
  "name": "First run on an erased iPhone",
  "about": "Run with --erase: a true first install (no Keychain item, no Local Network grant). The tester opens the app, meets the pairing screen and its nearby search, mistypes the PIN, tries an expired code, pairs, lands on an empty Home, then tries the used code again from Pair another host.",
  "appearance": "light",
  "timeout": 900,
  "launch": {"appearance": "default"},
  "steps": [
    {"do": "alert", "button": "Allow", "optional": true, "timeout": 10, "note": "iOS asks for the local network as the nearby search starts"},
    {"do": "wait", "type": "text", "label": "Connect to your host", "timeout": 30},
    {"do": "screenshot", "name": "first-run-pairing"},
    {"do": "assertExists", "type": "button", "label": "Scan pairing QR code"},
    {"do": "assertExists", "type": "button", "label": "Search again"},
    {"do": "assertDisabled", "id": "pairButton", "scroll": "up", "note": "Pair device needs an address and a code"},
    {"do": "sleep", "seconds": 6, "note": "the nearby search has had time to look"},
    {"do": "screenshot", "name": "first-run-nearby-searched"},
    {"do": "assertExists", "type": "text", "label": "Nearby computers", "note": "the nearby list or its empty state; a host found on the network is never selected or paired (it may be the owner's own Mac)"},

    {"do": "type", "id": "pairingAddress", "text": "${address}", "scroll": "up"},
    {"do": "type", "id": "pairingCode", "text": "0000000000"},
    {"do": "type", "id": "pairingFingerprint", "text": "${fingerprint}"},
    {"do": "screenshot", "name": "first-run-wrong-pin-typed"},
    {"do": "tap", "id": "pairButton", "scroll": "up"},
    {"do": "wait", "type": "text", "labelContains": "invalid or expired", "timeout": 20},
    {"do": "screenshot", "name": "first-run-wrong-pin"},
    {"do": "assertVisible", "type": "text", "labelContains": "invalid or expired", "timeout": 5, "note": "B-1: the person who tapped Pair device sees why it failed, in the system's alert (PA-2, 2026-10-06)"},
    {"do": "alert", "button": "OK", "note": "OK puts the alert away"},
    {"do": "assertAbsent", "id": "workspaceSwitcher", "note": "a wrong PIN stays on pairing"},

    {"do": "hostCheck", "command": "paircode", "payload": {"expires": "1s"}, "as": "expiredCode"},
    {"do": "sleep", "seconds": 3},
    {"do": "clear", "id": "pairingCode", "scroll": "up"},
    {"do": "type", "id": "pairingCode", "text": "${expiredCode}"},
    {"do": "tap", "id": "pairButton", "scroll": "up"},
    {"do": "wait", "type": "text", "labelContains": "invalid or expired", "timeout": 20},
    {"do": "screenshot", "name": "first-run-expired-code"},
    {"do": "assertVisible", "type": "text", "labelContains": "invalid or expired", "timeout": 5},
    {"do": "alert", "button": "OK"},
    {"do": "assertAbsent", "id": "workspaceSwitcher", "note": "an expired code stays on pairing"},

    {"do": "clear", "id": "pairingCode", "scroll": "up"},
    {"do": "type", "id": "pairingCode", "text": "${code}"},
    {"do": "screenshot", "name": "first-run-good-code"},
    {"do": "tap", "id": "pairButton", "scroll": "up"},
    {"do": "wait", "id": "workspaceSwitcher", "timeout": 40},
    {"do": "alert", "button": "Allow", "optional": true, "timeout": 3},
    {"do": "assertAbsent", "type": "text", "label": "Connect to your host", "timeout": 5},
    {"do": "wait", "id": "homeNewChat", "timeout": 20},
    {"do": "screenshot", "name": "first-run-home"},
    {"do": "assertValue", "id": "workspaceSwitcher", "contains": "Home"},
    {"do": "assertDisabled", "id": "workspaceSwitcher", "note": "Home alone has nothing to switch to"},
    {"do": "invariants"},
    {"do": "tap", "id": "homeRecentWork"},
    {"do": "wait", "id": "homeExpandedActionBox"},
    {"do": "screenshot", "name": "first-run-resume-box"},
    {"do": "tap", "id": "homeActionBoxClose"},
    {"do": "tap", "id": "openWorkspace"},
    {"do": "wait", "id": "homeFolderCurrent", "timeout": 15},
    {"do": "assertLabel", "id": "homeFolderCurrent", "equals": "Developer"},
    {"do": "screenshot", "name": "first-run-workspace-box"},
    {"do": "tap", "id": "homeActionBoxClose"},

    {"do": "helper", "name": "settingsPage", "argument": "Connection"},
    {"do": "screenshot", "name": "first-run-connection"},
    {"do": "tap", "id": "connectionPair", "scroll": "up", "note": "Pair Another Host… (title case since batch 3; labelContains is case-sensitive)"},
    {"do": "wait", "type": "text", "label": "Connect to your host", "timeout": 15},
    {"do": "screenshot", "name": "pair-another-host"},
    {"do": "assertExists", "type": "text", "label": "Saved hosts", "soft": true, "scroll": "up"},
    {"do": "type", "id": "pairingAddress", "text": "${address}", "scroll": "up"},
    {"do": "type", "id": "pairingCode", "text": "${code}"},
    {"do": "type", "id": "pairingFingerprint", "text": "${fingerprint}"},
    {"do": "tap", "id": "pairButton", "scroll": "up"},
    {"do": "wait", "type": "text", "labelContains": "invalid or expired", "timeout": 20, "note": "B-4: a used code's refusal shows over the sheet, in the system's alert"},
    {"do": "assertVisible", "type": "text", "labelContains": "invalid or expired", "timeout": 5},
    {"do": "alert", "button": "OK"},
    {"do": "screenshot", "name": "pair-another-used-code"},
    {"do": "hostCheck", "command": "hostalive", "payload": {"running": true}},
    {"do": "tap", "type": "button", "labelContains": "localhost", "scroll": "down", "soft": true, "note": "the saved host takes the tester back"},
    {"do": "sleep", "seconds": 2},
    {"do": "screenshot", "name": "after-choosing-saved-host"},
    {"do": "wait", "id": "workspaceSwitcher", "timeout": 30},
    {"do": "screenshot", "name": "back-on-saved-host"},
    {"do": "invariants"}
  ]
}
